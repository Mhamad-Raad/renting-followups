{
  "name": "rent-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Offline Windows desktop app for tracking monthly rent.",
  "author": "Mhamad Raad",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "predev": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prepreview": "install-electron",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win --x64",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "install-electron && electron-vite build",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "seed": "node scripts/run-ts.mjs scripts/seed.ts",
    "demo": "node scripts/demo.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "fontkit": "2.0.4",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "exceljs": "4.4.0",
    "i18next": "26.5.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.0",
    "react-router": "8.5.0",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "electron-winstaller": false,
    "fsevents": false
  },
  "main": "./out/main/index.js"
}
